==============================================================================

GigBid Environment Configuration (.env.example)

Copy to .env and fill in secrets. NEVER commit .env to version control.

==============================================================================

--- Core Application & Security ---

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-64-char-random-hex-string

Fernet 32-byte URL-safe base64 key for encrypting Upwork OAuth tokens at rest

Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENCRYPTION_KEY=change-me-to-a-valid-fernet-base64-key==

--- Marketplace Mode & GigSim Simulator (Starter-Kit Aligned) ---

Allowed values: gigsim | upwork_live

MARKETPLACE_MODE=gigsim
GIGSIM_API_TOKEN=gigsim-dev-token-2026
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_DB_PATH=gigsim/gigsim.db

--- Model Profile Selection ---

Allowed values: open | paid

'open' uses local Ollama / vLLM or hosted open-weight APIs (Groq, OpenRouter, Together).

'paid' enables optional frontier models while retaining open-weight embeddings/reranker.

MODEL_PROFILE=open

--- Local Open-Weight Inference (Ollama / vLLM) ---

OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8008/v1

--- Hosted Open-Weight Model Providers (for CPU-only / Free-Tier Deployment) ---

OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

--- Optional Paid Frontier APIs (used ONLY when MODEL_PROFILE=paid) ---

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

--- Open-Weight Embeddings & Reranker (Used in BOTH open and paid profiles) ---

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

--- PostgreSQL + pgvector (Checkpointer, Memory Store, Vector Index, App DB) ---

POSTGRES_USER=gigbid
POSTGRES_PASSWORD=gigbid_dev_password
POSTGRES_DB=gigbid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gigbid:gigbid_dev_password@localhost:5432/gigbid

--- Redis (Background Worker Queue & Rate-Limiter State) ---

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
ARQ_REDIS_URL=redis://localhost:6379/1

--- MCP Server Endpoints & Ports ---

PORTFOLIO_MCP_HOST=0.0.0.0
PORTFOLIO_MCP_PORT=8091
PORTFOLIO_MCP_URL=http://localhost:8091/mcp

MARKETPLACE_MCP_HOST=0.0.0.0
MARKETPLACE_MCP_PORT=8092
MARKETPLACE_MCP_URL=http://localhost:8092/mcp

WORKSPACE_MCP_HOST=0.0.0.0
WORKSPACE_MCP_PORT=8093
WORKSPACE_MCP_URL=http://localhost:8093/mcp

--- Third-Party MCP Servers ---

Official Upwork MCP Server (OAuth 2.1 over Streamable HTTP)

UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback

GitHub MCP Server (for repository ingestion into Portfolio RAG)

GITHUB_PERSONAL_ACCESS_TOKEN=

--- Observability & Tracing ---

LangSmith or Self-Hosted Langfuse

TRACING_PROVIDER=langfuse
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid-ai4016

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

--- Safety & Guardrails ---

Hard-enforced false: GigBid NEVER submits proposals or messages without human approval

AUTO_SEND_ENABLED=false
PII_MASKING_ENABLED=true
DEFAULT_WEEKLY_CONNECTS_BUDGET=60

--- Frontend Web App ---

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GigBid